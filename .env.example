# ── MedInsight environment variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Django core
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=medinsight
POSTGRES_USER=medinsight_user
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Clinical access control
# Set to True to enforce doctor-first access logic (approval workflow not yet built).
# Leave False for demo/development — all authenticated users can read all patient data.
ENFORCE_CLINICAL_ACCESS=False

# OCR microservice (ai-service). Use http://ai-service:8001 inside Docker Compose;
# localhost when Django runs on the host and ai-service is published on 8001.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=180
